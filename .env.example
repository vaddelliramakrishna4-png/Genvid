# ============================================================================
# GenVid — Environment Variables Template
# ============================================================================
# Copy this file to `.env.local` and fill in your REAL values.
#   cp .env.example .env.local
#
# NEVER commit your real .env.local — it is already listed in .gitignore.
# This file (.env.example) must contain ONLY placeholder values.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. AI / LLM Provider Keys
# ---------------------------------------------------------------------------

# Google Gemini — Used for script generation (Gemini Flash) and
# image generation (Imagen). Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — Fast LLM inference fallback (optional).
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------------
# 2. Media Provider Keys
# ---------------------------------------------------------------------------

# Cloudflare Workers AI — Used for image generation via CF Workers.
# Get these from: https://dash.cloudflare.com → AI → Workers AI
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here

# Pexels — Free stock video/image fallback for B-roll.
# Get yours at: https://www.pexels.com/api/new/
PEXELS_API_KEY=your_pexels_api_key_here

# Hugging Face — Used by Kokoro TTS and faster-whisper models.
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ---------------------------------------------------------------------------
# 3. Database & Storage (Supabase)
# ---------------------------------------------------------------------------
# All values come from your Supabase project dashboard:
#   https://supabase.com/dashboard → Project Settings → API

# Direct PostgreSQL connection string (used by Drizzle / raw queries)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.your_project_ref:your_db_password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase client credentials
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# 4. Job Queue (Upstash QStash + Redis)
# ---------------------------------------------------------------------------
# QStash is used to dispatch async render pipeline steps.
# Get these from: https://console.upstash.com/qstash

QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key_here

# Upstash Redis — Used for rate limiting, caching pipeline state, and
# job deduplication. Get these from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ---------------------------------------------------------------------------
# 5. Authentication (Google OAuth)
# ---------------------------------------------------------------------------
# Used for Google Sign-In via Supabase Auth.
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-project-ref.supabase.co/auth/v1/callback

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---------------------------------------------------------------------------
# 6. App Configuration
# ---------------------------------------------------------------------------

# Public URL of your deployed app (used for QStash webhook callbacks)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT secret for API route auth (auto-set by Supabase, rarely needed manually)
# JWT_SECRET=your_jwt_secret_here
